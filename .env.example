# Shopify Storefront API — see src/lib/shopify/README.md for full setup
# instructions, how to create a Storefront API access token, and what
# SHOPIFY_CONTENT_MODE does. Do not commit real values — copy this file to
# .env.local (already gitignored) and fill it in there.

# Your store's *.myshopify.com domain, no protocol (e.g. tt-house.myshopify.com).
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=

# Storefront API access token from a Shopify Headless/Storefront API app.
# This is a public, scoped token by Shopify's own design (distinct from an
# Admin API token) — see src/lib/shopify/README.md for why it is still
# never sent to the browser in this codebase.
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Storefront API version, e.g. 2024-10. Defaults to 2024-10 if unset.
SHOPIFY_STOREFRONT_API_VERSION=

# One of: local | shopify | auto
#   local   — always use local placeholder data (default; no credentials needed)
#   shopify — require valid Shopify configuration; fails clearly if unavailable
#   auto    — use Shopify when configured, otherwise fall back to local data
SHOPIFY_CONTENT_MODE=local
